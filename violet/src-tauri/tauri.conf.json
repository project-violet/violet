{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Violet",
  "version": "0.1.0",
  "identifier": "dev.violet.app",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Violet",
      "width": 1280,
      "height": 850,
      "minWidth": 360,
      "minHeight": 500
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: violet-media: http://violet-media.localhost; connect-src 'self' ipc: http://ipc.localhost https: http: violet-media:; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Violet image reader",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
